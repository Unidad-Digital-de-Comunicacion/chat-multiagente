<?xml version="1.0" encoding="utf-8"?>
<!-- Notas internas entre operadores: el hilo arriba y la caja para escribir una nota abajo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/listaNotas"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/textSinNotas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/notas_vacio"
            android:visibility="gone" />

    </FrameLayout>

    <LinearLayout
        android:id="@+id/filaNota"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <EditText
            android:id="@+id/editNota"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/notas_hint" />

        <Button
            android:id="@+id/botonEnviarNota"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/conversacion_boton_enviar" />

    </LinearLayout>

</LinearLayout>
