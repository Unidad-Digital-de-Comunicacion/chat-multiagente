<?xml version="1.0" encoding="utf-8"?>
<!-- Detalle de una conversación: el hilo de mensajes arriba, ocupando todo
     el espacio libre, y abajo la caja para responder + el botón de cerrar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <TextView
        android:id="@+id/textEtiquetas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingMultiplier="1.3"
        android:padding="12dp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/listaMensajes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/filaRespuesta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <EditText
            android:id="@+id/editMensaje"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/conversacion_hint_mensaje" />

        <Button
            android:id="@+id/botonEnviar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/conversacion_boton_enviar" />

    </LinearLayout>

    <Button
        android:id="@+id/botonCerrar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/conversacion_boton_cerrar" />

</LinearLayout>
