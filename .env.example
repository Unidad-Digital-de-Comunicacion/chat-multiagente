# Postgres
POSTGRES_USER=chatplatform
POSTGRES_PASSWORD=changeme
POSTGRES_DB=chatplatform
POSTGRES_READONLY_USER=readonly_user
POSTGRES_READONLY_PASSWORD=changeme_ro

# Django (core)
DJANGO_SECRET_KEY=changeme
DJANGO_DEBUG=True
# "10.0.2.2" es la IP con la que el EMULADOR de Android ve a esta misma PC
# (para que la UDCOperadorAPP le pueda pegar a Core corriendo en Docker).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,core,10.0.2.2

# CORS: orígenes del/los frontend(s) autorizados a llamar a la API (separados por coma)
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3001

# Admin Panel (React): URL de Core que el navegador del usuario va a llamar.
# Se incrusta en el build de Vite (build ARG), no es una env var de runtime.
ADMIN_PANEL_CORE_API_URL=http://localhost:8001

# Ídem, para los links a Swagger/Redoc de Conversation Engine en "Plataforma
# > Manuales y API" — HTTP, no ws/wss (eso es CONVERSATION_ENGINE_PUBLIC_URL
# más abajo, para el cliente operador). En producción (udcchat.com.ar):
# https://realtime.udcchat.com.ar — mismo dominio que CONVERSATION_ENGINE_
# PUBLIC_URL de más abajo, sólo cambia el esquema (Cloudflare sirve HTTP y
# WS sobre el mismo "Public Hostname", ver docker-compose.yml).
ADMIN_PANEL_CONVERSATION_ENGINE_URL=http://localhost:8003

# JWT (RS256): Core firma con la privada y expone la pública en /api/auth/jwks/.
# Se generan solas al arrancar el contenedor si no existen (ver services/core/entrypoint.sh).
JWT_PRIVATE_KEY_PATH=/app/keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/app/keys/jwt_public.pem

# Meta / WhatsApp (channel-gateway) — Fase 3
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# Opcional: sólo hace falta si Instagram quedó dado de alta en el dashboard
# de Meta bajo una app DISTINTA a la de arriba (pasa si Instagram se
# configuró por separado en vez de agregarse como producto de la misma app
# que ya tiene WhatsApp/Messenger) — si no se completa, channel-gateway usa
# META_APP_ID/META_APP_SECRET también para verificar la firma de Instagram.
META_APP_ID_INSTAGRAM=
META_APP_SECRET_INSTAGRAM=

# Email (recuperar contraseña). Backend "console" en dev: el link de reset
# queda impreso en `docker compose logs core`, no se manda de verdad.
# Para un proveedor real: EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# + EMAIL_HOST/EMAIL_PORT/EMAIL_HOST_USER/EMAIL_HOST_PASSWORD/EMAIL_USE_TLS.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-responder@chatplatform.local

# URL pública del Admin Panel — para armar el link de reset de contraseña.
FRONTEND_URL=http://localhost:3000

# URL pública de Channel Gateway — para armar `webhook_url` en el Admin Panel
# (Canales). En dev es el puerto publicado del contenedor; en producción, el
# dominio público real del servicio.
CHANNEL_GATEWAY_PUBLIC_URL=http://localhost:8002

# Token con el que Channel Gateway se autentica contra la API interna de
# Core (header `Authorization: Service-Token <valor>`). Se genera desde el
# Admin Panel: Plataforma > Tokens de servicios internos > Channel Gateway >
# Generar — pegar acá el valor en texto plano que devuelve esa acción (sólo
# se muestra una vez).
CORE_SERVICE_TOKEN=

# URL pública de Conversation Engine (WebSocket de tiempo real,
# `WS /ws/operador/{token}`) — la que usan la app Android y Operators Desk
# Web, no `http://conversation-engine:8000` (interna, sólo la ve Core). En
# dev es el puerto publicado del contenedor; en producción (udcchat.com.ar):
# wss://realtime.udcchat.com.ar — detrás del mismo Cloudflare Tunnel que ya
# expone Channel Gateway (un segundo "Public Hostname" en el mismo túnel,
# Service Type HTTP, apuntando a `conversation-engine:8000` — no hace falta
# un túnel ni un token nuevos, ver docker-compose.yml). Documentado también
# en docs/operators-desk-api-contract.md §7.
CONVERSATION_ENGINE_PUBLIC_URL=ws://localhost:8003

# Token con el que Core avisa a Conversation Engine (`conversations.
# conversation_engine_client.notificar_evento`) que reenvíe por WebSocket
# algo que le pasó a una conversación — dirección inversa de
# CORE_SERVICE_TOKEN de arriba. Se genera igual: Admin Panel > Plataforma >
# Tokens de servicios internos > Conversation Engine > Generar, y este
# mismo valor va también en la variable CORE_SERVICE_TOKEN del contenedor
# conversation-engine (ver docker-compose.yml) — ahí se llama igual porque,
# del lado de ESE servicio, es "el secreto que comparto con Core".
CONVERSATION_ENGINE_SERVICE_TOKEN=

# Cloudflare Tunnel (opcional, servicio `cloudflared`, no arranca por
# defecto — ver docker-compose.yml): token del túnel "remotely-managed"
# creado en el dashboard de Cloudflare Zero Trust (Networks > Tunnels).
# Sirve para exponer Channel Gateway con un dominio propio y HTTPS real sin
# IP pública, que es lo que Meta necesita para poder llamar a los webhooks.
CLOUDFLARE_TUNNEL_TOKEN=
