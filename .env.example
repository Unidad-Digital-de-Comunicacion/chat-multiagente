# Postgres
POSTGRES_USER=chatplatform
POSTGRES_PASSWORD=changeme
POSTGRES_DB=chatplatform
POSTGRES_READONLY_USER=readonly_user
POSTGRES_READONLY_PASSWORD=changeme_ro

# Django (core)
DJANGO_SECRET_KEY=changeme
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,core

# CORS: orígenes del/los frontend(s) autorizados a llamar a la API (separados por coma)
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3001

# JWT (RS256): Core firma con la privada y expone la pública en /api/auth/jwks/.
# Se generan solas al arrancar el contenedor si no existen (ver services/core/entrypoint.sh).
JWT_PRIVATE_KEY_PATH=/app/keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/app/keys/jwt_public.pem

# Meta / WhatsApp (channel-gateway) — Fase 3
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
