# Force LF for files that run inside Linux containers (entrypoints, Dockerfiles,
# scripts run by docker-entrypoint-initdb.d, etc.), regardless of a
# contributor's core.autocrlf setting on Windows — a CRLF shebang line
# (`#!/usr/bin/env bash\r`) fails with "No such file or directory".
*.sh text eol=lf
Dockerfile text eol=lf
*.dockerfile text eol=lf
entrypoint.sh text eol=lf
